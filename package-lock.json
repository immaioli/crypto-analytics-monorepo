{
  "name": "dashboard-cripto",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "dashboard-cripto",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=20.0.0"
      }
    },
    "apps/api": {
      "name": "@dashboard-cripto/api",
      "version": "0.1.0",
      "dependencies": {
        "@dashboard-cripto/shared-types": "0.1.0"
      }
    },
    "apps/web": {
      "name": "@dashboard-cripto/web",
      "version": "0.1.0"
    },
    "node_modules/@dashboard-cripto/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@dashboard-cripto/shared-types": {
      "resolved": "packages/shared-types",
      "link": true
    },
    "node_modules/@dashboard-cripto/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.8.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.8.3.tgz",
      "integrity": "sha512-p1diW6TqL9L07nNxvRMM7hMMw4c5XOo/1ibL4aAIGmSAt9slTE1Xgw5KWuof2uTOvCg9BY7ZRi+GaF+7sfgPeQ==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/shared-types": {
      "name": "@dashboard-cripto/shared-types",
      "version": "0.1.0",
      "devDependencies": {
        "typescript": "^5.8.3"
      }
    }
  }
}
